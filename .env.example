# Credenciales de Alpaca PAPER TRADING (no commitear el .env real).
# El bot lo carga con python-dotenv, o puedes hacer `source .env`.
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""

# Opcionales
export ALPACA_PAPER="true"          # siempre true: el bot rechaza live trading
export ALPACA_SYMBOLS="AAPL,MSFT"
export ALPACA_DATA_FEED="iex"       # "sip" solo si tu plan lo incluye
export FAST_SMA="9"
export SLOW_SMA="21"
export RISK_PER_TRADE="0.02"        # 2% del equity por operación
export TRAILING_STOP_PERCENT="2"
export TAKE_PROFIT_PERCENT="6"
export MAX_POSITION_PCT="0.25"      # tope de exposición por posición
export TARGET_PROFIT_MIN="100"      # beneficio objetivo mínimo por operación (USD)
export TARGET_PROFIT_MAX="1000"     # beneficio objetivo máximo por operación (USD)
export PROTECTION_MODE="trailing"   # "trailing" (trailing 2% + TP 6%) o "bracket" (nativa)
export POLL_INTERVAL_SECONDS="900"  # 15 minutos
export LOG_FILE="trading_bot.log"
